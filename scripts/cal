#!/bin/bash
# Apple Calendar reader for the day-planner skill.
#   cal [YYYY-MM-DD] [days]      default: today, 1 day
#   cal --calendars              list calendars: id · account · title · selected
# TSV: start · end · minutes · timed|allday · calendar · title · location · url
# Compiles the Swift/EventKit reader once and caches the binary next to it.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/.cal-bin"
SRC="$DIR/cal.swift"
if [ ! -x "$BIN" ] || [ "$SRC" -nt "$BIN" ]; then
  if ! command -v swiftc >/dev/null 2>&1; then
    echo "swiftc not found — install Command Line Tools: xcode-select --install" >&2
    exit 5
  fi
  swiftc -O -o "$BIN" "$SRC" >/dev/null
fi
exec "$BIN" "$@"
